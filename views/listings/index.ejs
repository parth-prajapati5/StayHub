<% layout('/layouts/boilerplates') %>
  <style>
    .filters {
      width: 100%;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      text-align: center;
      margin: 0 1rem;
      margin-bottom: 1.5rem;
    }
.scroll-wrapper{
   width: 70%;
    display:flex;
    align-items:center;
    position:relative;
    /* margin-right: 4rem; */
}

.scroll-container{
    display:flex;
    overflow-x:auto;
    scroll-behavior:smooth;
    scrollbar-width:none;
}

.scroll-container::-webkit-scrollbar{
    display:none;
}

.scroll-btn{
    background:white;
    text-align: center;
    border:1px solid #ddd;
    padding:5px;
    border-radius: 50%;
    cursor:pointer;
    margin: 0 0.2rem;
}

    .filter {
      width: max-content;
      margin: 1rem;
      opacity: 0.7;
      display: inline-block;  
     }

    .filter:hover {
      cursor: pointer;
      opacity: 1;
    }

    .filter p {
      white-space: nowrap;
      /* font-size: 0.9rem; */
      font-weight: 500;
    }

    .text-toggle {
      margin-left: 1.5rem;
      padding: 1rem 0.7rem;
      border: 1px solid #cbcbcb;
      border-radius: 10px;
      display: flex;
      align-items: center;
    }

    .text-info{
      display:none;
    }
  </style>

  <body>
    <!-- <%- include('../include/flash')  %> -->
    <!-- <h1 class="text-center mt-4 mb-4">All Listings</h1>   -->
    <div class="filters">
      <button class="scroll-btn left" onclick="scrollToLeft()"><i class="fa-solid fa-angle-left"></i></button>
      <div class="scroll-wrapper">
        <div class="scroll-container" id="scrollContainer">
          <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p class="">Trending</p>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p class="">Rooms</p>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-person-snowboarding"></i></div>
            <p class="">Surfing</p>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-water-ladder"></i></div>
            <p class="">Amazing pools</p>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-umbrella-beach"></i></div>
            <p class="">Beach</p>
          </div>

          <div class="filter">
            <div><i class="fa-solid fa-house-chimney-window"></i></div>
            <p class="">Beach</p>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-campground"></i></div>
            <p class="">Camping</p>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-mountain-sun"></i></div>
            <p class="">Mountain</p>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-city"></i></div>
            <p class="">City</p>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-tree"></i></div>
            <p class="">Nature</p>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p class="">Unique stays</p>
          </div>

          <div class="filter">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p class="">Unique stays</p>
          </div><div class="filter">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p class="">Unique stays</p>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p class="">Unique stays</p>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p class="">Unique stays</p>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p class="">Unique stays</p>
          </div>
          <div class="filter">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p class="">Unique stays</p>
          </div>
        </div>
      </div>
      <button class="scroll-btn right" onclick="scrollRight()"><i class="fa-solid fa-angle-right"></i></button>

      <div class="text-toggle">
        <div class="form-check form-switch form-check-reverse">
          <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault" >
          <label class="form-check-label" for="switchCheckDefault">Display total before Taxes</label>
        </div>
      </div>
    </div>



    <div class="row  row-cols-lg-4 row-cols-md-3 row-cols-sm-1 g-4 justify-content-center mb-2">
      <% for(let listing of alllistings) { %>
        <div class="card cols listing-card" style="width: 20rem;">
          <a href="/listings/<%=listing._id%>" class="listing-links">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="..." style="height: 20rem;">

            <div class="card-img-overlay"></div>
            <div class="card-body">
              <p class="card-text">
                <b>
                  <%= listing.title %>
                </b> <br>
                &#x20B9;<%= listing.price?.toLocaleString("en-IN") || "N/A" %>/night
                  <i class="text-info">&nbsp; &nbsp; +18% GST</i>
              </p>
            </div>
          </a>
        </div>
        <% } %>
    </div>
    <!-- <form action="/listings/new" method="get">
      <button>Create New Listing</button>
     </form> -->
  </body>


  <script>
     let textswitch=document.querySelector('#switchCheckDefault');
      textswitch.addEventListener('click',()=>{
        let textInfo=document.getElementsByClassName('text-info');    
        for(info of textInfo){
          if(info.style.display != 'inline' ){
            info.style.display='inline';
          }else{
                         info.style.display='none';

          }

        }
      })
  </script>