<% layout('/layouts/boilerplates') %>
    <div class="row mt-4 mb-5">

        <div class="col col-8 offset-3">
            <h3>
                <%= listing.title %>
            </h3>
        </div>
        <div class="card  col-6 offset-3 show mt-2 mb-3 listing-card">
            <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="Listing_image">
            <p class="mt-1"><b>Owner</b>: <%= listing.owner.username %>
            </p>
            <p>
                <%= listing.description %>
            </p>
            <p> &#x20B9;<%= listing.price?.toLocaleString("en-IN") || "N/A" %>/night </p>
            <p>
                <%= listing.location %>
            </p>
            <p>
                <%= listing.country %>
            </p>
        </div>

        <div class="row">
            <div class="col-2 offset-3">
                <% if(currUser && currUser._id.equals(listing.owner._id)){ %>
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark add-btn">Edit Listing</a>
            </div>
            <div class="col-3">
                <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                    <button class="btn btn-dark">Delete Listing</button>

                </form>
            </div>
            <% } %>
        </div>


        <div class="col-8 offset-3">
            <% if(!currUser) { %>
                <p>Please log in to leave a review.</p>
                <% } else { %>
                    <hr>
                    <h4>Leave a Review</h4>
                    <form action="/listings/<%= listing._id %>/review" method="post">
                        <!-- <div>
                    <label for="rating" class="form-label">Rating</label>
                    <input type="range" name="review[rating]" id="rating" min="1" max="5" class="form-range">
                    </div> -->
                        <label for="rating" class="form-label">Rating</label>
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1"
                                checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>

                        <div class="mb-3">
                            <label for="comment" class="form-label">Comment</label>
                            <textarea name="review[comment]" id="comment" rows="5" cols="10"
                                class="form-control"></textarea>
                        </div>

                        <button class="btn btn-outline-dark">Submit</button>
                    </form>
                    <% } %>

                        <% if(listing.reviews.length> 0) { %>
                            <hr>
                            <h4>All Review</h4>
                            <!-- <p><%= listing.reviews %></p> -->
                            <div class="row">
                                <% for(review of listing.reviews){ %>
                                    <div class="card mb-3 col-5 ms-3 pt-1">
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <%= review.author.username %>
                                            </h5>

                                            <!-- <p>
                                            <%= review.rating %> stars
                                        </p> -->
                                            <p class="starability-result" data-rating=<%=review.rating %>></p>
                                            <p class="card-text">
                                                <%= review.comment %>
                                            </p>
                                            <!-- <p class="card-text">
                                <%= review.createdAt.toLocaleDateString("en-CA") %>
                                </p> -->
                                        </div>

                                        <form method="post"
                                            action="/listings/<%= listing._id %>/review/<%= review._id %>?_method=DELETE">
                                            <button class="btn btn-dark mb-2">Delete</button>
                                        </form>
                                    </div>
                                    <% } %>
                            </div>

                            <% } %>
        </div>
        <div class="col-8 offset-3">
            <h2>Where you’ll be</h2>
            <div id="map"></div>

        </div>

    </div>
 <script>
     var Coordinates = <%- JSON.stringify( listing.geometry.coordinates)%>;
 </script>
       