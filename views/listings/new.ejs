<% layout('/layouts/boilerplates') %>

      <div class="row">

            <div class="col-8 offset-2">
                  <h3 class="mt-3 mb-4">Create New Listing</h3>
                  <form action="/listings" method="post" novalidate class="needs-validation"
                        enctype="multipart/form-data">
                        <div class="mb-3">

                              <label for="title">Title Name</label>
                              <input type="text" id="title" name="listing[title]" placeholder="Enter Title"
                                    class="form-control" required>
                              <div class="valid-feedback">
                                    Title looks good!
                              </div>

                        </div>

                        <div class="mb-3">
                              <label for="description">Description</label>
                              <textarea name="listing[description]" id="description" class="form-control"
                                    required></textarea>
                        </div>

                        <!-- <div class="mb-3">
                              <label for="image">Image Link</label>
                              <input type="text" name="listing[image][url]" placeholder="Enter Image URL/LINK"
                                    id="image" class="form-control">
                        </div> -->
                        <div class="mb-3">
                              <label for="image">Upload Listing Image</label>
                              <input type="file" name="image" id="image" class="form-control" required>
                        </div>
                        <div class="row">
                              <div class="mb-3 col-md-3">
                                    <label for="price">Price</label>
                                    <input type="number" id="price" name="listing[price]" placeholder="Enter Price"
                                          class="form-control" required>

                                    <div class="invalid-feedback">
                                          Price Should be valid.
                                    </div>
                              </div>
                              <div class="mb-3 col-md-9">
                                    <label for="country">Country </label>
                                    <input type="text" id="country" name="listing[country]" placeholder="Enter Country"
                                          class="form-control" required>

                                    <div class="invalid-feedback">
                                          Country Name Should be valid.
                                    </div>
                              </div>

                        </div>

                        <div class="row ">
                              <div class="mb-3 col-md-3">
                                    <label for="location">Location</label>
                                    <input type="text" id="location" name="listing[location]"
                                          placeholder="Enter Location" class="form-control" required>
                              </div>

                              <!-- <div class=" mb-3 col-md-9">
                                    <label for="category">Category</label>
                                    <select name="category" id="category" class="form-select" required>
                                          <option value="iconic cities">Iconic city</option>
                                          <option value="farm">Farm</option>
                                          <option value="trending">Trending</option>
                                          <option value="mountains">Mountains</option>
                                    </select>
                              </div> -->
                        </div>
                        <button class="btn btn-dark add-btn">Add</button>
                  </form>

            </div>
      </div>